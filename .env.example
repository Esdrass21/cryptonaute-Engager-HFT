# Secrets ONLY — never commit real values. See config/live.example.yaml.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MISTRAL_API_KEY=
# Crypto exchange keys: <EXCHANGE>_API_KEY / <EXCHANGE>_SECRET, where <EXCHANGE> is the
# value of execution.exchange (binance|bybit|okx|kraken|coinbase). Only the active exchange
# is read at connect time.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
RISK_SIGNING_KEY=cryptonaute-local-dev-key

# --- Market-data providers (data.market.source=providers) ---
# Alpaca: crypto + US stocks + FX. Paper/live trading via https://alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Alpha Vantage: FX intraday + digital currency daily (free tier ~25 req/day)
ALPHAVANTAGE_API_KEY=
# Twelve Data: FX, metals (XAU/USD), crypto, stocks (free tier 8 req/min)
TWELVEDATA_API_KEY=
# Finazon: custom publisher/dataset time series
FINAZON_API_KEY=

# Bus / observability
REDIS_URL=redis://localhost:6379/0
